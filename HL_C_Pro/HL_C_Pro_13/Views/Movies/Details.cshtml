@model MovieManager.Models.Movie

@{
    ViewData["Title"] = Model.Title;

    string? youtubeEmbedUrl = null;
    if (!string.IsNullOrEmpty(Model.MovieUrl))
    {
        try
        {
            var rawUrl = Model.MovieUrl.Trim();
            if (!rawUrl.StartsWith("http://") && !rawUrl.StartsWith("https://"))
                rawUrl = "https://" + rawUrl;

            var uri = new Uri(rawUrl);
            if (uri.Host.Contains("youtube.com"))
            {
                var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
                if (query.TryGetValue("v", out var vid))
                    youtubeEmbedUrl = $"https://www.youtube.com/embed/{vid}";
            }
            else if (uri.Host.Contains("youtu.be"))
            {
                youtubeEmbedUrl = $"https://www.youtube.com/embed/{uri.AbsolutePath.TrimStart('/')}";
            }
        }
        catch { }
    }
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h1 class="card-title mb-4">🎬 @Model.Title</h1>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <p><strong>Жанр:</strong> <span class="badge bg-info text-dark">@Model.Genre</span></p>
                            <p><strong>Рік випуску:</strong> @Model.Year</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.MovieFilePath) || !string.IsNullOrEmpty(Model.MovieUrl))
                    {
                        <div class="mb-4">
                            <h5 class="mb-3">📹 Перегляд фільму</h5>
                            @if (!string.IsNullOrEmpty(Model.MovieUrl))
                            {
                                @if (youtubeEmbedUrl != null)
                                {
                                    <div class="ratio ratio-16x9 rounded overflow-hidden">
                                        <iframe src="@youtubeEmbedUrl"
                                                title="@Model.Title"
                                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                                allowfullscreen></iframe>
                                    </div>
                                }
                                else
                                {
                                    <video width="100%" height="auto" style="max-height: 500px;" class="rounded" controls controlsList="nodownload">
                                        <source src="@Model.MovieUrl" type="video/mp4" />
                                        Ваш браузер не підтримує відео тег.
                                    </video>
                                    <small class="text-muted d-block mt-2">📌 Примітка: Скачування файлу заборонено</small>
                                }
                            }
                            else if (!string.IsNullOrEmpty(Model.MovieFilePath))
                            {
                                <!-- Програвач для завантаженого файла -->
                                <video width="100%" height="auto" style="max-height: 500px;" class="rounded" controls controlsList="nodownload">
                                    <source src="@Model.MovieFilePath" type="video/mp4" />
                                    Ваш браузер не підтримує відео тег.
                                </video>
                                <small class="text-muted d-block mt-2">📌 Примітка: Скачування файлу заборонено</small>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-4">
                            ⚠️ Файл або посилання на фільм не додано. 
                            <a asp-action="Edit" asp-route-id="@Model.Id"
                               asp-route-returnUrl="@Url.Action("Details", new { id = Model.Id })"
                               class="alert-link">Додайте медіа</a>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id"
                           asp-route-returnUrl="@Url.Action("Details", new { id = Model.Id })"
                           class="btn btn-warning">
                            ✏️ Редагувати
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            ← Назад до каталогу
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
