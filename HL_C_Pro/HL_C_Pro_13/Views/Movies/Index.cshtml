@model IEnumerable<MovieManager.Models.Movie>

@{
    ViewData["Title"] = "Мій менеджер фільмів";
    string curTitle = ViewBag.CurrentTitle ?? "";
    string sort     = ViewBag.SortBy       ?? "id_desc";
    var selectedGenres = (List<string>)(ViewBag.SelectedGenres ?? new List<string>());
    var selectedYears  = (List<int>)(ViewBag.SelectedYears     ?? new List<int>());

    string Icon(string col) =>
        sort == col + "_asc"  ? " ▲" :
        sort == col + "_desc" ? " ▼" : " ⇅";

    string NextSort(string col) =>
        sort == col + "_asc" ? col + "_desc" : col + "_asc";

    var nextTitle = NextSort("title");
    var nextGenre = NextSort("genre");
    var nextYear  = NextSort("year");

    var iconTitle = Icon("title");
    var iconGenre = Icon("genre");
    var iconYear  = Icon("year");

    var sortOptions = new (string Val, string Label)[]
    {
        ("id_desc",    "Нові додані перші"),
        ("id_asc",     "Старі додані перші"),
        ("title_asc",  "Назва А → Я"),
        ("title_desc", "Назва Я → А"),
        ("year_desc",  "Рік ↓ (новіший)"),
        ("year_asc",   "Рік ↑ (старіший)"),
        ("genre_asc",  "Жанр А → Я"),
        ("genre_desc", "Жанр Я → А"),
    };
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="Create" class="btn btn-success">+ Додати новий фільм</a>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form id="filterForm" method="get" asp-action="Index">
                <div class="row g-3 mb-3">
                    <div class="col-12">
                        <label class="form-label fw-bold">🔍 Пошук за назвою фільму</label>
                        <input name="title" type="text" class="form-control" placeholder="Введіть назву фільму..." value="@curTitle" />
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">🎬 Фільтрувати по жанру</label>
                        <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                            @if (ViewBag.AllGenres != null && ViewBag.AllGenres.Count > 0)
                            {
                                @foreach (var genre in ViewBag.AllGenres)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="genres" id="genre_@genre" value="@genre" @(selectedGenres.Contains(genre) ? "checked" : "") />
                                        <label class="form-check-label" for="genre_@genre">@genre</label>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small">Немає доступних жанрів</p>
                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">📅 Фільтрувати по року</label>
                        <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
                            @if (ViewBag.AllYears != null && ViewBag.AllYears.Count > 0)
                            {
                                @foreach (var year in ViewBag.AllYears)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="years" id="year_@year" value="@year" @(selectedYears.Contains(year) ? "checked" : "") />
                                        <label class="form-check-label" for="year_@year">@year</label>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted small">Немає доступних років</p>
                            }
                        </div>
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">⇅ Сортування</label>
                        <select id="sortSelect" name="sortBy" class="form-select" onchange="this.form.submit()">
                            @foreach (var o in sortOptions)
                            {
                                if (sort == o.Val)
                                {
                                    <option value="@o.Val" selected>@o.Label</option>
                                }
                                else
                                {
                                    <option value="@o.Val">@o.Label</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary me-2">🔍 Шукати</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">⟲ Скинути</a>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th style="cursor:pointer" onclick="doSort('@nextTitle')">Назва фільму @iconTitle</th>
                    <th style="cursor:pointer" onclick="doSort('@nextGenre')">Жанр @iconGenre</th>
                    <th style="cursor:pointer" onclick="doSort('@nextYear')">Рік @iconYear</th>
                    <th class="text-center">Дії</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var movie in Model)
                    {
                        var detailsUrl = Url.Action("Details", new { id = movie.Id });
                        <tr style="cursor:pointer" onclick="window.location='@detailsUrl'">
                            <td class="fw-bold">@movie.Title</td>
                            <td><span class="badge bg-info text-dark">@movie.Genre</span></td>
                            <td>@movie.Year</td>
                            <td class="text-center" onclick="event.stopPropagation()">
                                <a asp-action="Edit" asp-route-id="@movie.Id"
                                   asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                   class="btn btn-sm btn-outline-warning">✏️</a>
                                <a asp-action="Delete" asp-route-id="@movie.Id" class="btn btn-sm btn-outline-danger">🗑️</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted">Фільмів не знайдено</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
    function doSort(val) {
        document.getElementById('sortSelect').value = val;
        document.getElementById('filterForm').submit();
    }
    </script>
}
