@model MovieManager.Models.Movie

@{
    ViewData["Title"] = "Редагувати фільм";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title mb-4">@ViewData["Title"]</h3>

                    <form id="uploadForm" asp-action="Edit" method="post" enctype="multipart/form-data" novalidate>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Genre" class="form-label"></label>
                            <input asp-for="Genre" class="form-control" />
                            <span asp-validation-for="Genre" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Year" class="form-label"></label>
                            <input asp-for="Year" type="number" class="form-control" />
                            <span asp-validation-for="Year" class="text-danger small"></span>
                        </div>

                        <div class="card bg-light mb-3">
                            <div class="card-body">
                                <h6 class="card-title mb-3">🎬 Управління медіа фільму</h6>

                                @if (!string.IsNullOrEmpty(Model.MovieFilePath) || !string.IsNullOrEmpty(Model.MovieUrl))
                                {
                                    <div id="currentMediaBlock" class="alert alert-info mb-3">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong>✓ Поточне медіа</strong><br />
                                                @if (!string.IsNullOrEmpty(Model.MovieFilePath))
                                                {
                                                    <span class="small">📁 @System.IO.Path.GetFileName(Model.MovieFilePath)</span>
                                                }
                                                else if (!string.IsNullOrEmpty(Model.MovieUrl))
                                                {
                                                    <span class="small">🔗 </span>
                                                    <a href="@Model.MovieUrl" target="_blank" class="small text-break">@Model.MovieUrl</a>
                                                }
                                            </div>
                                            <button type="button" id="removeMediaBtn" class="btn btn-sm btn-outline-danger ms-3 flex-shrink-0">
                                                🗑️ Вилучити
                                            </button>
                                        </div>
                                        <div id="removeWarning" class="mt-2 text-danger small d-none">
                                            ⚠️ Медіа буде видалено після натискання «Оновити»
                                        </div>
                                    </div>
                                    <input type="hidden" id="removeMedia" name="removeMedia" value="false" />
                                }

                                <div class="mb-3">
                                    <label for="movieFile" class="form-label">
                                        <strong>Замінити файлом</strong>
                                    </label>
                                    <input type="file" id="movieFile" name="movieFile" class="form-control" accept=".mp4,.webm,.avi,.mkv,.mov" />
                                    <small class="text-muted">Якщо завантажите новий файл, попередній буде видалений</small>
                                </div>

                                <div class="text-center text-muted mb-3">
                                    <strong>АБО</strong>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="MovieUrl" class="form-label">
                                        <strong>Замінити посиланням</strong>
                                    </label>
                                    <input asp-for="MovieUrl" class="form-control" placeholder="https://youtube.com/watch?v=... або https://example.com/film.mp4" />
                                    <small class="text-muted">Підтримується: YouTube, youtu.be, прямі URL на MP4/WebM</small>
                                </div>
                            </div>
                        </div>

                        <div id="progressWrapper" class="mb-3 d-none">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-semibold small">⬆️ Завантаження файлу</span>
                                <span id="selectedFileName" class="text-muted small text-truncate ms-2" style="max-width:60%"></span>
                            </div>
                            <div class="progress" style="height:24px;">
                                <div id="progressBar"
                                     class="progress-bar progress-bar-striped progress-bar-animated bg-success fw-semibold"
                                     role="progressbar"
                                     style="width:0%;"
                                     aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">0%</div>
                            </div>
                            <div id="progressInfo" class="text-muted small mt-1 text-center"></div>
                        </div>

                        <div class="d-flex gap-2">
                            <button id="submitBtn" type="submit" class="btn btn-primary">Оновити</button>
                            <a href="@(ViewBag.ReturnUrl ?? Url.Action("Index"))" class="btn btn-outline-secondary">← Повернутися</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
    (function () {
        const form       = document.getElementById('uploadForm');
        const fileInput  = document.getElementById('movieFile');
        const wrapper    = document.getElementById('progressWrapper');
        const bar        = document.getElementById('progressBar');
        const info       = document.getElementById('progressInfo');
        const nameLabel  = document.getElementById('selectedFileName');
        const submitBtn  = document.getElementById('submitBtn');
        const removeBtn  = document.getElementById('removeMediaBtn');
        const removeInput = document.getElementById('removeMedia');
        const removeWarn = document.getElementById('removeWarning');
        const mediaBlock = document.getElementById('currentMediaBlock');
        let startTime;

        // ── Кнопка «Вилучити» ──────────────────────────────────────────
        if (removeBtn) {
            removeBtn.addEventListener('click', function () {
                const removing = removeInput.value === 'false';
                removeInput.value = removing ? 'true' : 'false';
                removeWarn.classList.toggle('d-none', !removing);
                mediaBlock.classList.toggle('alert-info', !removing);
                mediaBlock.classList.toggle('alert-warning', removing);
                removeBtn.textContent = removing ? '↩️ Скасувати' : '🗑️ Вилучити';
                removeBtn.classList.toggle('btn-outline-danger', !removing);
                removeBtn.classList.toggle('btn-outline-secondary', removing);
            });
        }

        fileInput.addEventListener('change', function () {
            if (this.files.length > 0) {
                nameLabel.textContent = this.files[0].name;
                wrapper.classList.remove('d-none');
                resetBar();
            } else {
                wrapper.classList.add('d-none');
            }
        });

        form.addEventListener('submit', function (e) {
            if (fileInput.files.length === 0) return;
            e.preventDefault();
            startTime = Date.now();
            submitBtn.disabled = true;
            submitBtn.textContent = 'Завантаження...';

            const xhr = new XMLHttpRequest();

            xhr.upload.addEventListener('progress', function (e) {
                if (!e.lengthComputable) return;
                const pct     = Math.round(e.loaded / e.total * 100);
                const elapsed = (Date.now() - startTime) / 1000;
                const speed   = elapsed > 0 ? e.loaded / elapsed : 0;
                const remain  = speed > 0 ? (e.total - e.loaded) / speed : Infinity;
                bar.style.width = pct + '%';
                bar.setAttribute('aria-valuenow', pct);
                bar.textContent = pct + '%';
                info.textContent = fmtBytes(e.loaded) + ' / ' + fmtBytes(e.total)
                    + ' · ' + fmtBytes(speed) + '/с'
                    + ' · залишилось ~' + fmtTime(remain);
            });

            xhr.addEventListener('load', function () {
                bar.style.width = '100%';
                bar.textContent = '100%';
                bar.classList.remove('progress-bar-animated', 'progress-bar-striped');
                if (xhr.status >= 200 && xhr.status < 400) {
                    info.textContent = '✅ Завантаження завершено, перенаправлення...';
                    window.location.href = xhr.responseURL;
                } else {
                    bar.classList.add('bg-danger');
                    info.textContent = '❌ Помилка сервера: ' + xhr.status;
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Оновити';
                }
            });

            xhr.addEventListener('error', function () {
                bar.classList.add('bg-danger');
                info.textContent = '❌ Помилка мережевого з\'єднання';
                submitBtn.disabled = false;
                submitBtn.textContent = 'Оновити';
            });

            xhr.open('POST', form.action);
            xhr.send(new FormData(form));
        });

        function resetBar() {
            bar.style.width = '0%';
            bar.setAttribute('aria-valuenow', 0);
            bar.textContent = '0%';
            bar.classList.remove('bg-danger');
            bar.classList.add('progress-bar-animated', 'progress-bar-striped');
            info.textContent = '';
        }

        function fmtBytes(b) {
            if (b < 1024)             return b.toFixed(0) + ' Б';
            if (b < 1048576)          return (b / 1024).toFixed(1) + ' КБ';
            if (b < 1073741824)       return (b / 1048576).toFixed(1) + ' МБ';
            return (b / 1073741824).toFixed(2) + ' ГБ';
        }

        function fmtTime(s) {
            if (!isFinite(s) || s < 0) return '...';
            if (s < 60)   return Math.ceil(s) + ' с';
            if (s < 3600) return Math.ceil(s / 60) + ' хв';
            return (s / 3600).toFixed(1) + ' год';
        }
    })();
    </script>
}
