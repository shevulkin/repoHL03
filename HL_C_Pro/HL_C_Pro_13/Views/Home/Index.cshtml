@{
    ViewData["Title"] = "Головна";
}

<div class="hero-section mb-5 animate-in">
    <h1>🎬 Каталог фільмів</h1>
    <p class="lead mb-4">Ваш персональний менеджер кіноколекції</p>
    <a asp-controller="Movies" asp-action="Index" class="btn btn-light btn-lg px-4 py-2 fw-bold" style="border-radius:50px;">
        Перейти до перегляду →
    </a>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4 animate-in">
        <div class="card card-hover h-100 shadow-sm">
            <div class="card-body feature-card">
                <div class="feature-icon">📋</div>
                <h5 class="fw-bold">Каталогізація</h5>
                <p class="text-muted mb-0">Додавайте, редагуйте та організовуйте свою колекцію фільмів в одному місці</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 animate-in">
        <div class="card card-hover h-100 shadow-sm">
            <div class="card-body feature-card">
                <div class="feature-icon">🔍</div>
                <h5 class="fw-bold">Пошук та фільтри</h5>
                <p class="text-muted mb-0">Шукайте за назвою, фільтруйте за жанром та роком, сортуйте як зручно</p>
            </div>
        </div>
    </div>
    <div class="col-md-4 animate-in">
        <div class="card card-hover h-100 shadow-sm">
            <div class="card-body feature-card">
                <div class="feature-icon">▶️</div>
                <h5 class="fw-bold">Перегляд</h5>
                <p class="text-muted mb-0">Завантажуйте відео або додавайте посилання на YouTube для перегляду прямо в браузері</p>
            </div>
        </div>
    </div>
</div>

