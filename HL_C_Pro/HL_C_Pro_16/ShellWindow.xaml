<Window x:Class="MyApp.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyApp"
        Title="Додаток" Height="320" Width="450"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Шаблон для LoginViewModel — показує форму входу -->
        <DataTemplate DataType="{x:Type local:LoginViewModel}">
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Авторизація"
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBox Grid.Row="1"
                         Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" Padding="6,4" Margin="0,0,0,10"/>

                <PasswordBox Grid.Row="2"
                             Height="32" Padding="6,4" Margin="0,0,0,20">
                    <PasswordBox.Style>
                        <Style TargetType="PasswordBox">
                            <EventSetter Event="PasswordChanged" Handler="PasswordBox_PasswordChanged"/>
                        </Style>
                    </PasswordBox.Style>
                </PasswordBox>

                <Button Grid.Row="3"
                        Content="Увійти"
                        Height="36" FontSize="14"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding CanLogin}"/>
            </Grid>
        </DataTemplate>

        <!-- Шаблон для PersonModel — показує головний екран -->
        <DataTemplate DataType="{x:Type local:PersonModel}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ім'я:"
                           VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Email:"
                           VerticalAlignment="Center" Margin="0,0,10,10"/>
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding Greeting}" FontSize="16"
                           Foreground="Green" Margin="0,10,0,0"/>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Vertical" Margin="0,15,0,0">
                    <TextBlock Text="{Binding ClickCount, StringFormat='Натиснуто: {0}'}"
                               FontSize="14" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Збільшити" Width="120"
                                Command="{Binding IncrementCommand}" Margin="0,0,10,0"/>
                        <Button Content="Скинути" Width="100"
                                Command="{Binding ResetCommand}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                        Content="Очистити форму"
                        Command="{Binding ClearFormCommand}"
                        Width="150" HorizontalAlignment="Left"
                        VerticalAlignment="Top" Margin="0,10,0,0"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- Єдиний ContentControl — замінює вміст без нового вікна -->
    <ContentControl Content="{Binding CurrentView}"/>

</Window>
